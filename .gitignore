# =============================================================================
# RevertIQ .gitignore
# =============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# --- Virtual Environments ---
venv/
env/
.env/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Data (keep repo lightweight) ---
data/raw/
data/processed/
data/results/
*.csv
*.parquet
*.h5
*.db
*.sqlite

# --- Logs ---
logs/
*.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ---
.env
*.secret
